# CoTester FAZ 3 — job-scoped env (injected by backend at run time; placeholders for local runs)
# Mobile device/Appium settings use COTESTER_MOBILE_RUN_CONTEXT (see runner contract).
# Do not commit real secrets.

TEST_ENV=dev

# App login credentials (same WEB credential profile as UI)
COTESTER_WEB_USERNAME=
COTESTER_WEB_PASSWORD=
UI_USERNAME=
UI_PASSWORD=

# Optional API base for setup steps (non-secret)
COTESTER_API_BASE_URL=
BASE_URL=

# Legacy credential slug fallback
# UI_CREDENTIAL_PROFILE=default

# Required for mobile runs (backend-written JSON, not credentials)
# COTESTER_MOBILE_RUN_CONTEXT=/absolute/path/to/reports/run-context/{jobId}.json
